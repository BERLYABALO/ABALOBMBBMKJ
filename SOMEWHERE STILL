
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Somewhere, Still</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #1f1f1f;
            color: #eeeeee;
            font-family: Consolas, monospace;
        }

        header {
            padding: 15px;
            background: #181818;
            border-bottom: 1px solid #333;
        }

        .tab {
            color: #e5a8c7;
        }

        .editor {
            padding: 20px;
        }

        textarea {
            width: 100%;
            height: 300px;
            resize: vertical;
            padding: 15px;
            background: #111;
            color: #d9a9b6;
            border: 1px solid #444;
            font-family: Consolas, monospace;
            font-size: 14px;
        }

        button {
            padding: 12px 20px;
            background: #d9a9b6;
            color: #181818;
            border: none;
            cursor: pointer;
            margin-top: 12px;
        }

        #videoScreen {
            display: none;
            position: fixed;
            inset: 0;
            background: black;
            z-index: 10;
        }

        #videoScreen video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        #closeButton {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 11;
        }
    </style>
</head>

<body>

    <header>
        <span class="tab">♥ somewhere_still.html</span>
    </header>

    <main class="editor">
        <h2>Somewhere, Still</h2>
        <p>For the feelings that never really left.</p>

        <textarea id="code" spellcheck="false"
            placeholder="Write your thoughts here...">I thought I was over you.

But some nights,
I still remember everything.</textarea>

        <br>

        <button onclick="playVideo()">▶ RUN</button>
    </main>

    <div id="videoScreen">
        <button id="closeButton" onclick="closeVideo()">
            CLOSE ×
        </button>

        <video id="yearningVideo" controls playsinline>
            <source src="yearning.mp4" type="video/mp4">
            Your browser does not support video.
        </video>
    </div>

    <script>
        function playVideo() {
            const screen = document.getElementById("videoScreen");
            const video = document.getElementById("yearningVideo");

            screen.style.display = "block";

            video.play().catch(function () {
                alert("Please press Play to start your video.");
            });
        }

        function closeVideo() {
            const screen = document.getElementById("videoScreen");
            const video = document.getElementById("yearningVideo");

            video.pause();
            screen.style.display = "none";
        }
    </script>

</body>
</html>
